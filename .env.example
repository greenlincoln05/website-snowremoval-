# Names only. Real values go in Cloudflare Pages > Settings > Environment variables
# (and in .dev.vars for local `wrangler pages dev`). Never commit real values.
# Use Stripe TEST-mode keys and test-mode price IDs until the whole flow is verified.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_TIME=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEASON=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: canonical site origin for Stripe return_url (defaults to the request origin).
SITE_URL=
